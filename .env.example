# Athathi — environment variables
#
# Phase 01 requires NO environment variables; the foundation runs entirely
# locally with no cloud credentials. This file documents variables that later
# phases will introduce. Copy to `.env.local` and fill in when those phases
# arrive. Never commit real secrets.

# --- Phase 08: Supabase (auth, PostgreSQL, storage, RLS) ---
# The backend is OPTIONAL. With NONE of these set, Athathi runs in DEMO DATA MODE:
# the Phase 03 catalog + a labelled local/demo auth + local supplier workspace —
# fully usable with zero credentials. Set BOTH public vars to switch to Supabase
# (backendMode() → "supabase"); apply supabase/migrations first (see supabase/README.md).
#
# NEXT_PUBLIC_SUPABASE_URL=          # project URL (public, client-safe)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=     # anon key (public, RLS-protected)
# SUPABASE_SERVICE_ROLE_KEY=         # SERVER-ONLY — never exposed to the browser (admin/service tasks)
#
# Optionally pin the visualization/agent/vision provider selection alongside.

# --- Phase 05: Room Analysis / Vision AI (all server-only; never exposed to the client) ---
# Vision is OPTIONAL. With no key set, the AI Designer works fully in manual mode
# and can show a clearly-labelled sample analysis. Set ONE provider key to enable
# real analysis; the app auto-selects the first configured provider, or you can
# pin one with ATHATHI_VISION_PROVIDER.
#
# ATHATHI_VISION_PROVIDER=       # optional: "anthropic" | "openai" | "gemini"
# ATHATHI_VISION_MODEL=          # optional: override the default vision model
#
# ANTHROPIC_API_KEY=             # enables the Anthropic (Claude) vision provider
# OPENAI_API_KEY=                # enables the OpenAI vision provider
# GOOGLE_GENERATIVE_AI_API_KEY=  # enables the Google Gemini vision provider

# --- Phase 06: AI Agent (all server-only; never exposed to the client) ---
# The Agent is OPTIONAL. With no key set, it runs as the deterministic Demo Agent
# (real catalog tools, no LLM). Set an Anthropic or OpenAI key to enable the
# LLM-orchestrated tool loop. Reuses ANTHROPIC_API_KEY / OPENAI_API_KEY above.
#
# ATHATHI_AGENT_PROVIDER=        # optional: "anthropic" | "openai"
# ATHATHI_AGENT_MODEL=           # optional: override the default agent model

# --- Phase 07: Before/After Visualization (all server-only; never exposed to the client) ---
# The room visualization is OPTIONAL. With no image-generation provider configured
# (current state), Athathi runs the deterministic DEMO composition: a labelled
# "Demo Preview" rendered over the room photo in the browser — the photo is NOT
# uploaded. No fake AI render is ever produced. To enable real image generation,
# register a verified provider in src/lib/visualization/service.ts (REAL_PROVIDERS)
# and set its credential + (optionally) pin it here. Only the real (live) path
# uploads the room image, and only after explicit user consent.
#
# ATHATHI_VISUALIZATION_PROVIDER=   # optional: pins a registered image provider by id
# ATHATHI_VISUALIZATION_MODEL=      # optional: override the default visualization model

# --- Phase 10B: Payments (all server-only; never exposed to the client) ---
# Payment is OPTIONAL. With NO gateway configured (current state), Athathi runs an
# honest, deterministic DEMO PAYMENT provider: intents live per-browser, are clearly
# labelled "Demo Payment", and NO real money moves. No card / CVV / PIN / bank field
# exists anywhere — a real integration must be HOSTED/TOKENIZED (the provider collects
# sensitive data on its own PCI surface) and Athathi stores only safe references.
# To enable live payment: implement PaymentProvider in
# src/lib/payments/providers/<name>.ts, register it in REAL_PROVIDERS
# (src/lib/payments/providers/index.ts), set its credential below, and (optionally)
# pin it. paymentMode() then flips to "live"; checkout/orders/UI are unchanged.
# NEVER commit a real payment secret.
#
# ATHATHI_PAYMENT_PROVIDER=      # optional: pins a registered gateway by id
# ATHATHI_PAYMENT_<PROVIDER>_KEY=  # SERVER-ONLY secret key for the chosen gateway (per-provider)
# ATHATHI_PAYMENT_WEBHOOK_SECRET=  # SERVER-ONLY: verify webhook signatures (raw-body + timestamp/replay + dedupe)

# --- Later: site URL for metadata / canonical / sitemap ---
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
