# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real secrets. The example template IS committed.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ── Athathi: local-only, not for a public repo ──────────────────────────────
# QA artifacts (rendered-page HTML dumps / preview snapshots — regenerated locally).
/docs/qa/
# Local-machine skills inventory — documents this developer's private machine
# and unrelated projects; not part of the Athathi product.
/docs/ALL_LOCAL_SKILLS_INVENTORY.md
# Internal AI build-brief prompts (phase specs incl. unbuilt future work + local
# paths). Kept locally; not part of the shipped product. Remove this line to publish them.
/.claude-prompts/
# Scratch / editor / OS noise
*.bak
*.swp
*.orig
Thumbs.db
